            "since": "2021-01-01",
            "note": "《侵权责任法》已随《民法典》施行同时废止；其第58条（病历瑕疵推定过错）由《民法典》第1222条承继。"
                   "2026 年仍见网络文章标注『《侵权责任法》第58条（2026）』，属典型旧法错误，引用一律改引《民法典》第1222条。"},
        ("刑法", 335): {"status": "current",
            "note": "医疗事故罪：医务人员严重不负责任，造成就诊人死亡或严重损害身体健康，处三年以下有期徒刑或拘役。现行有效。"},
        ("医师法", 56): {"status": "current", "exact_wording_pending": True, "since": "2022-03-01",
            "nature": "医师罚则（违反诊疗规范不必要检查/未依注册事项执业等）",
            "note": "《医师法》2022-03-01 施行；上海《医师行政处罚裁量权基准》(2026-08-01 施行) 于该条下新增"
                   "『违反诊疗规范对患者实施不必要的检查、治疗造成不良后果』『未按注册执业地点/类别/范围执业』等违法行为。"
                   "引用前须核对条内款项序号。"},
        ("医疗纠纷预防和处理条例", 15): {"status": "current", "exact_wording_pending": True,
            "since": "2018-10-01", "nature": "病历书写与保管义务",
            "note": "国务院令第701号，现行有效。引用前须核对原文措辞。"},
        ("医疗纠纷预防和处理条例", 16): {"status": "current", "exact_wording_pending": True,
            "since": "2018-10-01", "nature": "病历封存与启封程序",
            "note": "国务院令第701号，现行有效。引用前须核对原文措辞。"},
        ("基本医疗卫生与健康促进法", 101): {"status": "current", "since": "2020-06-01",
            "note": "医疗卫生机构医疗质量安全管理制度不健全等情形的行政罚则，现行有效。"
                   "（马鞍山『院外会诊程序管理缺失』案马卫医罚〔2026〕6号即依本条处罚）"},
    }

    @classmethod
    def check(cls, law, article):
        key = (law, article)
        if key in cls.KB:
            return dict(cls.KB[key], hit=True)
        return {"hit": False, "status": "unknown", "note": "未登记，建议法律检索助手核验现行有效性。"}

    @classmethod
    def is_repealed(cls, law, article):
        m = cls.check(law, article)
        return m.get("status") == "repealed"

    @classmethod
    def needs_exact_verify(cls, law, article):
        m = cls.check(law, article)
        return m.get("hit") and m.get("exact_wording_pending", False)

    @classmethod
    def pending_exact_list(cls):
        return [(k[0], k[1], v.get("exact")) for k, v in cls.KB.items()
                if v.get("exact_wording_pending")]


# ============================================================================
# 6) SELECT_3 选文算法（复用给每日 / 回补）
# ============================================================================
HIGH_VALUE_KW = ["合同", "协议", "范本", "审查", "风险", "诉讼", "抗辩", "攻防", "侵权",
                 "工伤", "交通事故", "医疗纠纷", "医疗事故", "医疗合规", "医疗损害", "人身损害",
                 "赔偿", "合规", "慈善", "股权", "代持", "担保", "借贷", "租赁", "建设工程",
                 "仲裁", "执行", "裁判规则", "司法解释", "最高法", "指导案例", "公报案例",
                 "新规", "解读", "实务", "要点", "陷阱", "漏洞", "规避", "举证", "证据",
                 "违约金", "解除", "无效", "撤销", "关联交易", "免税", "票据"]
DEPTH_KW = ["指引", "操作", "全流程", "体系", "专题", "要点", "风险", "案例"]


def score_article(title):
    """返回 (score, 命中关键词列表)。同一关键词若同时落在高价值/深度两表，只计一次（高价值权重优先）。"""
    s = 0
    hits = []
    for kw in set(HIGH_VALUE_KW) | set(DEPTH_KW):
        if kw in (title or ""):
            s += 2 if kw in HIGH_VALUE_KW else 1
            hits.append(kw)
    return min(s, 12), hits


def select_3(cands, ingested_set, last_run_ts_ms, quota=3):
    """
    输入：cands=[{media_id,title,create_time}], ingested_set=set(media_id), last_run_ts_ms
    输出：(chosen, skipped_ingested, stat)
    实现 S2 分池 + S3 评分 + S4 选文（S1 拉取由调用方经工具完成）。
    """
    new_pool, backlog_pool = [], []
    skipped = 0
    for c in cands:
        if c["media_id"] in ingested_set:
            skipped += 1
            continue
        sc, _ = score_article(c.get("title", ""))
        c = dict(c)
        c["_score"] = sc
        if c.get("create_time", 0) >= last_run_ts_ms:
            new_pool.append(c)
        else:
            backlog_pool.append(c)
    new_pool.sort(key=lambda x: (x["_score"], x["create_time"]), reverse=True)
    backlog_pool.sort(key=lambda x: (x["_score"], -x["create_time"]), reverse=True)
    chosen = new_pool[:quota]
    if len(chosen) < quota:
        chosen += backlog_pool[: quota - len(chosen)]
    stat = {"new": len(new_pool), "backlog": len(backlog_pool),
            "skipped_ingested": skipped, "chosen": len(chosen)}
    return chosen, skipped, stat


# ============================================================================
# 7) 场景配置（每日 / 周日批 / 月度回灌 复用同一套库）
# ============================================================================
class IntakeConfig:
    """声明式配置：各自动化只需填自己的 stages / libs / quota / state_path。"""
    def __init__(self, name, stages, state_path=DEFAULT_STATE_PATH, quota=3,
                 libs=None, note=""):
        self.name = name
        self.stages = stages
        self.state_path = state_path
        self.quota = quota
        # None → 默认 IMA 5 库；显式传 {} → 空库（周日批/月度回灌独立状态，不塞 IMA 骨架）
        self.libs = IMA_LIBS if libs is None else libs
        self.note = note


# 每日摄入（本自动化）
DAILY_CONFIG = IntakeConfig(
    name="每日知识摄入",
    stages=DAILY_STAGES,
    quota=3,
    libs=IMA_LIBS,
    note="5 库 × 每日 3 篇；SELECT_3 新增优先；220030 不摄入；法条联动 StatuteHealthCheck。",
)

# 周日批 check_links（复用 RunState 单一真源 + checkpoint + StatuteHealthCheck）
SUNDAY_CONFIG = IntakeConfig(
    name="周日知识维护批处理",
    stages=SUNDAY_STAGES,
    state_path=os.path.join(ROOT, "03-连接/check_links_state.json"),
    quota=0,
    libs={},
    note="复用 RunState.checkpoint 续跑 + StatuteHealthCheck；空库独立状态文件，不污染 ima_intake_state。",
)

# 月度回灌（复用 IntakeState 同一 schema 的不同实例或同文件）
MONTHLY_CONFIG = IntakeConfig(
    name="月度回灌",
    stages=MONTHLY_STAGES,
    state_path=os.path.join(ROOT, "03-连接/monthly_backfill_state.json"),
    quota=0,
    libs={},
    note="复用 IntakeState + DegradationLayer + StatuteHealthCheck；空库独立状态文件，批量回填历史欠债。",
)


# ============================================================================
# 自检
# ============================================================================
def _now():
    return datetime.datetime.now().strftime("%Y-%m-%dT%H:%M")


def _now_ts():
    return str(int(datetime.datetime.now().timestamp() * 1000))


def selftest():
    print("=== intake_runner.py selftest ===")
    # 1) media_id 构造 + 截断判定
    ok_mid = make_media_id("0" * 32, "7312048136419112")
    # 真实截断：rawid 仅 8 位（旧 bug 曾把 32 位截成 8 位 → 220030 假失败）
    bad_mid = IMA_MEDIA_PREFIX + "_deadbeef_7312048136419112"
    assert DegradationLayer.classify(ok_mid, "220030", channel_ok=True)[0] == "persistent_220030"
    assert DegradationLayer.classify(bad_mid, "220030", channel_ok=True)[0] == "truncation"
    print("[OK] media_id 构造 + 220030/截断 判定")

    # 2) IntakeState 内存闭环（不落盘）
    st = IntakeState.__new__(IntakeState)
    st.path = ":memory:"
    st.data = st._init_blank()
    st._migrate()
    assert st.ingested_count() == 0
    assert st.mark_ingested("7312048136419112", ok_mid, "测试合同", 1788000000000, 8) is True
    assert st.mark_ingested("7312048136419112", ok_mid, "重复", 1788000000000, 8) is False  # 幂等
    assert st.ingested_count() == 1
    assert st.data["totals"]["ingested_total"] == 1
    assert st.is_ingested(ok_mid) is True
    # 失败登记 + 摄入后安全移除
    st.add_failed(ok_mid, "220030", "x")
    assert len(st.data["failed_220030"]) == 1
    assert st._remove_failed_if_ingested(ok_mid) is True
    assert len(st.data["failed_220030"]) == 0
    # 未摄入者绝不误删
    st.add_failed(bad_mid, "220030", "x")
    assert st._remove_failed_if_ingested(bad_mid) is False
    print("[OK] IntakeState 幂等/去重/totals重算/failed护栏")

    # 2b) 历史 null 字段迁移护栏（真实文件曾出现 checkpoint:null → 必须不崩）
    stn = IntakeState.__new__(IntakeState)
    stn.path = ":memory:"
    stn.data = {"schema": "ima_intake_state/v1.13", "libraries": None,
                "checkpoint": None, "pending_windows": None,
                "failed_220030": None, "b_pending_backfill": None,
                "last_run_ts_ms": None}
    stn._migrate()   # 曾在此 AttributeError 崩溃
    assert isinstance(stn.data["checkpoint"], dict)
    assert isinstance(stn.data["libraries"], dict) and len(stn.data["libraries"]) == 5
    assert stn.data["pending_windows"] == []
    assert stn.data["failed_220030"] == []
    assert stn.data["totals"]["ingested_total"] == 0
    print("[OK] IntakeState null 字段迁移护栏（checkpoint/libraries 为 null 不崩）")

    # 2c) libs 覆盖：空库场景（周日批/月度回灌）不塞 IMA 5 库骨架
    ste = IntakeState.__new__(IntakeState); ste.path = ":memory:"; ste.libs = {}
    ste.data = ste._init_blank(); ste._migrate()
    assert ste.data["libraries"] == {}
    assert ste.data["totals"]["ingested_total"] == 0
    assert ste.ingested_count() == 0
    print("[OK] IntakeState libs={} 空库不塞 IMA 骨架（周日/月度独立状态）")

    # 3) 状态机续跑
    st.new_session()
    m = IntakeMachine(st, DAILY_STAGES)
    plan0 = m.resume_plan()
    assert plan0 == DAILY_STAGES
    m.complete("A0"); m.complete("A1")
    st.data["checkpoint"]["status"] = "in_progress"
    st2 = IntakeState.__new__(IntakeState); st2.path = ":memory:"
    st2.data = st.data  # 模拟"中断后重新加载同状态"
    m2 = IntakeMachine(st2, DAILY_STAGES)
    assert m2.resume_plan() == ["B", "A2", "A2_5", "C", "D", "FINAL"]
    print("[OK] IntakeMachine 断点续跑（A0/A1 已完成自动跳过）")

    # 4) 法条体检
    assert StatuteHealthCheck.is_repealed("公司法", 71) is True
    assert StatuteHealthCheck.is_repealed("公司法", 84) is False
    assert StatuteHealthCheck.needs_exact_verify("最高法医疗损害解释", 16) is True
    assert StatuteHealthCheck.check("民法典", 1219)["status"] == "current"
    print("[OK] StatuteHealthCheck 旧法/现行/exact待核")

    # 5) SELECT_3
    cands = [
        {"media_id": "a", "title": "医疗纠纷赔偿指引", "create_time": 1789000000000},  # 已摄入
        {"media_id": "b", "title": "租赁合同范本", "create_time": 1789000000001},
        {"media_id": "c", "title": "股权转让协议审查", "create_time": 1789000000004},  # 同分中 create_time 最大
        {"media_id": "d", "title": "闲聊文章", "create_time": 1789000000003},
        {"media_id": "e", "title": "医疗纠纷赔偿要点", "create_time": 1789000000002},
    ]
    chosen, skipped, stat = select_3(cands, {"a"}, 1788000000000, quota=3)
    assert skipped == 1                       # a 已摄入
    assert len(chosen) == 3
    assert chosen[0]["title"] == "股权转让协议审查"   # b/c/e 同分(6)，c create_time 最大 → 优先
    assert chosen[1]["title"] == "医疗纠纷赔偿要点"
    print("[OK] SELECT_3 分池/评分/去重/配额  (stat=%s)" % stat)

    # 6) 升级阶梯
    st3 = IntakeState.__new__(IntakeState); st3.path = ":memory:"
    st3.data = st3._init_blank(); st3._migrate()
    st3.data["pending_windows"] = [{"d": 1}, {"d": 2}]
    assert DegradationLayer.escalation(st3)[0] == 2
    print("[OK] DegradationLayer 告警升级阶梯")

    print("=== ALL SELFTEST PASSED ===")
    return True


if __name__ == "__main__":
    import sys
    if "--selftest" in sys.argv:
        selftest()
    else:
        print("intake_runner.py v1.0 — 用法：")
        print("  python intake_runner.py --selftest        # 自检")
        print("  from intake_runner import IntakeState, IntakeMachine, DegradationLayer, StatuteHealthCheck, select_3, DAILY_CONFIG")
