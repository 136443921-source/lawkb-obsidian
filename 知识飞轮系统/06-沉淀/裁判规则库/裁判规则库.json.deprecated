{
  "metadata": {
    "database_name": "裁判规则库（JSON版）",
    "version": "1.0.0",
    "created_date": "2026-06-19",
    "last_updated": "2026-06-19",
    "total_rules": 4,
    "description": "收录各级法院在民商事案件中形成的裁判规则，供法律检索、类案比对和裁判观点参考使用。",
    "source": "提取自生效裁判文书，附案号供核实。",
    "disclaimer": "裁判规则非法律法规，不具备普遍约束力，但可作为类案检索和裁判观点参考。"
  },
  "rules": [
    {
      "rule_id": "R001",
      "category": "合同纠纷",
      "subcategory": "协议解除争议",
      "rule_content": "当事人发送'协商解除函'的，不构成单方解除通知，协议未因此解除。解除权的行使需要明确表达单方解除的意思。",
      "applicable_conditions": "合同纠纷中，一方发送函件表示希望解除协议，但内容上系协商解除提议的。",
      "case_support": [
        {
          "case_id": "(2022) 黔26民终1384号",
          "case_name": "贵州省冒井冷泉水渔业有限公司诉贵州省厚德鳝鱼生态渔业有限公司合同纠纷案",
          "court": "贵州省黔东南苗族侗族自治州中级人民法院",
          "date": "2022年"
        }
      ],
      "relevance": "高",
      "related_articles": [
        {
          "law": "《中华人民共和国民法典》",
          "article": "第563条",
          "content": "合同解除的法定事由"
        },
        {
          "law": "《中华人民共和国民法典》",
          "article": "第565条",
          "content": "解除通知到达对方时解除"
        }
      ],
      "details": {
        "裁判要旨": "解除权的行使需要明确表达单方解除的意思表示。当事人发送函件表示'协商解除'的，不构成《民法典》第565条规定的单方解除通知，协议不因该函件而解除。",
        "适用要点": [
          "解除通知应当明确表达单方解除的意思，不能含糊其辞。",
          "'协商解除'与'单方解除'法律效果不同：前者需双方达成一致，后者到达即生效。",
          "实践中需结合函件标题、正文内容、发送context综合判断。"
        ],
        "风险提示": [
          "发函方若想行使单方解除权，应当在函件中明确引用《民法典》第563条或第565条，并明确表达'通知你方解除合同'的意思。",
          "收函方若收到'协商解除函'，应当明确回复是否同意协商解除；不同意则协议继续有效。"
        ]
      },
      "date_added": "2026-06-19",
      "added_by": "小强律师（实习律师）"
    },
    {
      "rule_id": "R002",
      "category": "合同纠纷",
      "subcategory": "附条件法律行为",
      "rule_content": "附条件付款协议中，主张付款条件已成就的一方负有举证责任。未能提供充分证据的，承担不利后果。",
      "applicable_conditions": "附条件法律行为纠纷，付款条件是否成就存在争议。",
      "case_support": [
        {
          "case_id": "(2022) 黔26民终1384号",
          "case_name": "贵州省冒井冷泉水渔业有限公司诉贵州省厚德鳝鱼生态渔业有限公司合同纠纷案",
          "court": "贵州省黔东南苗族侗族自治州中级人民法院",
          "date": "2022年"
        }
      ],
      "relevance": "高",
      "related_articles": [
        {
          "law": "《中华人民共和国民法典》",
          "article": "第159条",
          "content": "恶意阻碍条件成就视为条件已成就"
        },
        {
          "law": "《中华人民共和国民事诉讼法》",
          "article": "第67条第1款",
          "content": "当事人对自己提出的主张，有责任提供证据。"
        }
      ],
      "details": {
        "裁判要旨": "附条件法律行为中，条件是否成就发生争议时，主张条件已成就的一方负有举证责任。未能提供充分证据证明条件已成就的，承担举证不能的不利后果。",
        "适用要点": [
          "举证责任分配：主张条件成就的一方举证，主张条件未成就的一方无需举证（除非主张'恶意阻碍条件成就'）。",
          "证据类型：包括书面协议、履行凭证、第三方证明、微信聊天记录等。",
          "《民法典》第159条适用：若当事人恶意阻碍条件成就，视为条件已成就。但主张'恶意阻碍'的一方需承担举证责任。"
        ],
        "风险提示": [
          "签订附条件协议时，应当明确约定条件成就的判断标准和举证责任。",
          "条件成就后，应当及时书面通知对方，并保留送达证据。",
          "若对方恶意阻碍条件成就，应当及时固定证据（微信聊天记录、书面函件等），以便主张视为条件已成就。"
        ]
      },
      "date_added": "2026-06-19",
      "added_by": "小强律师（实习律师）"
    },
    {
      "rule_id": "R003",
      "category": "环保合规",
      "subcategory": "环评与合同履行",
      "rule_content": "环评未通过导致项目无法继续推进，构成付款条件未成就的正当理由。",
      "applicable_conditions": "协议约定付款条件与项目推进相关，且环评是项目推进的前置条件。",
      "case_support": [
        {
          "case_id": "(2022) 黔26民终1384号",
          "case_name": "贵州省冒井冷泉水渔业有限公司诉贵州省厚德鳝鱼生态渔业有限公司合同纠纷案",
          "court": "贵州省黔东南苗族侗族自治州中级人民法院",
          "date": "2022年"
        }
      ],
      "relevance": "高",
      "related_articles": [
        {
          "law": "《中华人民共和国民法典》",
          "article": "第180条",
          "content": "不可抗力"
        },
        {
          "law": "《建设项目环境保护管理条例》",
          "article": "第11条",
          "content": "环评审批条件"
        }
      ],
      "details": {
        "裁判要旨": "项目建设需要环评手续的，环评未通过导致项目无法继续推进，付款条件（如'项目推进后付款'）未成就，付款义务暂不触发。",
        "适用要点": [
          "环评是法定程序，未通过则项目不具备合法建设条件。",
          "付款条件与项目推进挂钩的，项目因环评未通过而停滞的，付款条件未成就。",
          "但需注意：环评未通过是否构成'不可抗力'或'情势变更'，需结合合同约定和案件事实判断。"
        ],
        "风险提示": [
          "签订涉及环评的项目协议时，应当明确约定环评责任的承担方。",
          "若环评责任在付款义务方，其恶意不推进环评的，可能构成'恶意阻碍条件成就'（《民法典》第159条）。",
          "环评未通过不等于协议无法履行，需结合协议约定判断各方权利义务。"
        ]
      },
      "date_added": "2026-06-19",
      "added_by": "小强律师（实习律师）"
    },
    {
      "rule_id": "R004",
      "category": "民事诉讼",
      "subcategory": "举证责任分配",
      "rule_content": "主张附条件法律行为的条件已成就的当事人，负有举证责任。",
      "applicable_conditions": "附条件法律行为纠纷，条件是否成就存在争议。",
      "case_support": [
        {
          "case_id": "(2022) 黔26民终1384号",
          "case_name": "贵州省冒井冷泉水渔业有限公司诉贵州省厚德鳝鱼生态渔业有限公司合同纠纷案",
          "court": "贵州省黔东南苗族侗族自治州中级人民法院",
          "date": "2022年"
        }
      ],
      "relevance": "高",
      "related_articles": [
        {
          "law": "《中华人民共和国民事诉讼法》",
          "article": "第67条第1款",
          "content": "当事人对自己提出的主张，有责任提供证据。"
        }
      ],
      "details": {
        "裁判要旨": "附条件法律行为中，条件是否成就发生争议时，主张条件已成就的一方负有举证责任。",
        "适用要点": [
          "与R002规则内容相同，从不同角度归类。",
          "R002从'合同纠纷-附条件法律行为'角度归类，R004从'民事诉讼-举证责任分配'角度归类。"
        ],
        "风险提示": [
          "举证责任的分配直接影响诉讼结果，应当在诉前充分评估举证能力。",
          "若举证能力有限，应当在签订协议时明确约定条件成就的判断标准和举证责任。"
        ]
      },
      "date_added": "2026-06-19",
      "added_by": "小强律师（实习律师）"
    }
  ],
